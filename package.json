{
  "name": "@ldco/database",
  "version": "0.31.0",
  "private": false,
  "type": "module",
  "description": "Single source of truth for the shared LDCO MongoDB contract, plus the API that publishes the latest version.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "ldco-db-check": "./dist/cli/check.js",
    "ldco-db-init": "./dist/cli/init.js",
    "ldco-db-scope": "./dist/cli/scope.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/contract-lock.ts --verify && tsx scripts/verify-dist.ts",
    "build": "next build",
    "start": "next start",
    "package:build": "tsup",
    "contract:lock": "tsx scripts/contract-lock.ts --write",
    "contract:verify": "tsx scripts/contract-lock.ts --verify",
    "db:sync-local": "tsx --env-file-if-exists=.env.local scripts/sync-from-live.ts",
    "db:sync-sandbox": "tsx --env-file-if-exists=.env.local scripts/sync-to-sandbox.ts",
    "db:backup-live": "tsx --env-file-if-exists=.env.local scripts/backup-live.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:migrate:live": "tsx --env-file-if-exists=.env.local scripts/migrate.ts --live",
    "contract:infer": "tsx --env-file-if-exists=.env.local scripts/infer-contract.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file-if-exists=.env.local --experimental-test-module-mocks --test src/contract/declared-fields.test.ts src/catalogue/catalogue.test.ts src/catalogue/rank.test.ts src/catalogue/appDances.test.ts src/access/access.test.ts src/catalogue/edit.test.ts src/catalogue/review.test.ts src/dances/merge.test.ts src/server/catalogue/audit.test.ts src/server/catalogue/choreographerReview.test.ts src/server/catalogue/merge.test.ts src/lib/dancePublished.test.ts src/server/dancePatch.test.ts src/server/bodyGuards.test.ts"
  },
  "dependencies": {
    "jsdom": "^26.1.0",
    "mongodb": "^7.7.0",
    "next-auth": "^4.24.15",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "next": "^16.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
