# API (this project, on Vercel): optional bearer token required to read /api/contract
CONTRACT_API_TOKEN=

# UI: shared password for HTTP Basic auth (any username). UI refuses to serve if unset.
ADMIN_PASSWORD=

# Mongo the UI reads. Local docker test DB from line-dance-manager/docker-compose.yml:
MONGODB_URI=mongodb://root:rootpass@localhost:27017/?authSource=admin

# Only for `npm run db:sync-local`: live cluster to copy FROM (use a read-only user). Never used by the UI.
LIVE_MONGODB_URI=
SYNC_DATABASES=ldco,djfeed,bld,copperknob_alert,ldco-events,ldco-reviews,ldco-lessons,music_catalog

# Consuming apps (build-time check): nothing needed. ldco-db-check calls the public /api/contract/version
# on https://ldco-database-contract.vercel.app. Set this only to check against another contract API.
# LDCO_DATABASE_URL=http://localhost:3100
